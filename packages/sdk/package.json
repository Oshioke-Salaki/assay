{
  "name": "assayscore",
  "version": "0.2.0",
  "description": "Check Celo x402 sellers with Assay before paying them. Includes a drop-in guard for any x402 fetch client.",
  "license": "MIT",
  "author": "Oshioke Salaki",
  "homepage": "https://assayscore.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Oshioke-Salaki/assay.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/Oshioke-Salaki/assay/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "x402",
    "celo",
    "erc-8004",
    "agents",
    "reputation",
    "credit"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "assayscore-core": "workspace:*"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
