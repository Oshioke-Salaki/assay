{
  "name": "assayscore-mcp",
  "version": "0.4.0",
  "description": "MCP server for Assay: check Celo x402 sellers and ERC-8004 agents before paying them",
  "license": "MIT",
  "author": "Oshioke Salaki",
  "homepage": "https://assayscore.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Oshioke-Salaki/assay.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/Oshioke-Salaki/assay/issues"
  },
  "type": "module",
  "bin": {
    "assay-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "assayscore": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "x402",
    "celo",
    "agents"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
