{
  "name": "assayscore-core",
  "version": "0.1.0",
  "description": "Assay scoring engine: organic x402 revenue, payment loops and ratings for Celo",
  "license": "MIT",
  "author": "Oshioke Salaki",
  "homepage": "https://assayscore.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Oshioke-Salaki/assay.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Oshioke-Salaki/assay/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "x402",
    "celo",
    "credit",
    "scoring"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
