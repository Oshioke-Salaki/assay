# Assay server. Every variable is optional except where noted for a feature.
PORT=8787
ROLE=all                      # all | api | indexer
DATABASE_PATH=./data/assay.db
PUBLIC_URL=http://localhost:8787
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Data sources
SQD_URL=https://portal.sqd.dev/datasets/celo-mainnet
# Celo RPC. Production uses a Chainstack endpoint (keep it out of git: apps/server/.chainstack is
# ignored); forno and Ankr are the automatic fallbacks. Compare with: node scripts/rpc-bench.mjs
RPC_URL=https://forno.celo.org
BLOCKSCOUT_URL=https://celo.blockscout.com
BLOCKSCOUT_RPS=2
# INDEX_FROM_BLOCK=           # fresh databases only: start later than the beginning of x402 on Celo

# Selling paid reports over x402 (both required, else paid routes answer 503)
X402_API_KEY=                 # from https://x402.celo.org
PAY_TO=                       # the address that receives USA₮/USDC/USDT; declare it in the hackathon entry

# Signed scores (both required, else reports are unsigned)
ATTESTER_PRIVATE_KEY=
REGISTRY_ADDRESS=             # AssayRegistry, printed by `pnpm --filter @assay/server ops deploy-registry`

# The agent wallet: pays for X searches through the buy gateway (optional)
BUY_PAYER_KEY=
X_MENTIONS_DAILY_CAP_USD=0.5     # background searches, busiest and most-asked-about sellers first
X_ONDEMAND_DAILY_CAP_USD=2       # searches bought by paid checks (/v1/check/:address/x, $0.01); 0 turns the tier off

# Assay's own ERC-8004 identity, printed by `ops register-agent`
AGENT_ID=

# Operator CLI (ops.ts)
OPERATOR_PRIVATE_KEY=         # the one agent wallet of the hackathon entry
ATTRIBUTION_TAG=celo_27fe67eb1be5

# Switches on GET /v1/admin and the /admin page. At least 8 characters; openssl rand -hex 32 gives a strong one
ADMIN_KEY=
